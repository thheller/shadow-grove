   ["src/dev"
    "src/test"]
   :extra-deps
   {org.clojure/clojure {:mvn/version "1.12.6"}
    thheller/shadow-cljs {:mvn/version "3.5.11"}

    ;; signals example
    town.lilac/flex
    {:git/url "https://github.com/lilactown/flex"
     :git/sha "346bad039b560a62529a39af66e0afe35565b125"}}

   :override-deps
   {com.thheller/shadow-css {:local/root "../shadow-css"}}}

  :server
  {:jvm-opts ["-Dfile.encoding=UTF-8"]
   :main-opts ["-m" "shadow.cljs.devtools.cli" "run" "repl/start"]}}}
